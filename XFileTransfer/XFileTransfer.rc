BEGIN
    LTEXT           "구룡쟁패에서 오류가 발견되었습니다. ",IDC_STATIC,85,27,
                    143,10
    LTEXT           "관련된 파일을 전송하실 경우 게임 안정화에",IDC_STATIC,
                    84,55,143,10
    LTEXT           "파일을 전송 하시려면 확인을,  취소 하시려면",IDC_STATIC,
                    84,84,142,10
    LTEXT           "전송 ID",IDC_STATIC,84,116,32,8
    EDITTEXT        IDC_SENDERIDEDIT,117,113,111,12,ES_AUTOHSCROLL
    LTEXT           "전송중입니다.",IDC_TRANSFERSTATIC,84,142,94,10,NOT 
                    WS_VISIBLE
    CONTROL         "Progress1",IDC_PROGRESSBAR,"msctls_progress32",NOT 
                    WS_VISIBLE | WS_BORDER,84,154,144,6
    DEFPUSHBUTTON   "확인",IDOK,125,172,50,14
    PUSHBUTTON      "취소",IDCANCEL,178,172,50,14
    CONTROL         130,IDC_STATIC,"Static",SS_BITMAP | SS_SUNKEN,7,7,77,179
    LTEXT           "많은 도움을 주실 수 있습니다.",IDC_STATIC,85,66,143,10
    LTEXT           "이용에 불편을 드려 죄송합니다.",IDC_STATIC,85,39,143,10
    LTEXT           "눌러 주십시오.",IDC_STATIC,84,94,79,9
