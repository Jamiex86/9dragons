IDD_FTPOPTIONDIALOG DIALOGEX 0, 0, 239, 248
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Options"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    GROUPBOX        "[ 3D Device ]",IDC_STATIC,2,3,235,46
    LTEXT           "Resolution",IDC_STATIC,11,20,46,8,WS_DISABLED
    COMBOBOX        IDC_RESOLUTIONCOMBO,62,16,78,96,CBS_DROPDOWNLIST | 
                    WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    LTEXT           "ZBuffer",IDC_STATIC,11,36,46,8,WS_DISABLED
    COMBOBOX        IDC_ZBUFFERCOMBO,62,33,78,96,CBS_DROPDOWNLIST | 
                    WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Use hardware cursor",IDC_USEHARDWARECURSORCHECK,"Button",
                    BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP,149,34,78,10
    GROUPBOX        "[ Quality ]",IDC_STATIC,2,51,235,148
    CONTROL         "",IDC_STATIC,"Static",SS_BLACKFRAME,8,61,224,70
    CTEXT           "Texture resolution",IDC_STATIC,62,67,78,10,
                    SS_CENTERIMAGE | SS_SUNKEN
    CTEXT           "MipMap level",IDC_STATIC,149,67,78,10,SS_CENTERIMAGE | 
                    SS_SUNKEN
    LTEXT           "Terrain",IDC_STATIC,11,82,46,8
    COMBOBOX        IDC_TERRAINQUALITYCOMBO,62,79,78,96,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_TERRAINMIPLEVELCOMBO,149,79,78,96,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Building",IDC_STATIC,10,99,46,8
    COMBOBOX        IDC_BUILDINGQUALITYCOMBO,62,96,78,96,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_BUILDINGMIPLEVELCOMBO,149,96,78,96,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Charactor",IDC_STATIC,10,116,46,8
    COMBOBOX        IDC_CHARACTERQUALITYCOMBO,62,113,78,96,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_CHARACTERMIPLEVELCOMBO,149,113,78,96,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_STATIC,"Static",SS_BLACKFRAME,8,154,224,18
    LTEXT           "Shadow",IDC_STATIC,11,159,46,8
    COMBOBOX        IDC_CHARACTERSHADOWQUALITYCOMBO,62,156,78,96,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Character",IDC_USECHARACTERSHADOWCHECK,"Button",
                    BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP,149,159,36,10
    CONTROL         "Cloud",IDC_USECLOUDSHADOWCHECK,"Button",BS_AUTOCHECKBOX | 
                    BS_LEFTTEXT | WS_DISABLED | WS_TABSTOP,195,159,32,10
    PUSHBUTTON      "High quality",ID_SETVERYHIGHLEVELBUTTON,7,180,74,14
    PUSHBUTTON      "Medium quality",ID_SETMIDDLELEVELBUTTON2,82,180,74,14
    PUSHBUTTON      "Low quality",ID_SETLOWLEVELBUTTON,158,180,74,14
    LTEXT           "Use 3D Sound",IDC_STATIC,10,214,46,8,WS_DISABLED
    GROUPBOX        "[ Sound ]",IDC_STATIC,2,202,235,27
    COMBOBOX        IDC_3DSOUNDCOMBO,62,212,78,96,CBS_DROPDOWNLIST | 
                    WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,158,232,39,14
    PUSHBUTTON      "Cancel",IDCANCEL,199,232,38,14
    CONTROL         "",IDC_STATIC,"Static",SS_BLACKFRAME,8,133,224,18
    LTEXT           "Sight",IDC_STATIC,11,138,46,8
    COMBOBOX        IDC_SIGHTRANGECOMBO,62,135,78,96,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
END

IDD_FTPTRANSFER DIALOGEX 0, 0, 259, 113
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Download data..."
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         "Progress1",IDC_FTPDOWNLOADPROGRESS,"msctls_progress32",
                    PBS_SMOOTH | WS_BORDER,1,15,256,6
    CTEXT           "",IDC_TIMELEFT,77,29,126,8,SS_CENTERIMAGE
    CTEXT           "",IDC_FILESTATUS,1,3,256,9,0,WS_EX_STATICEDGE
    LTEXT           "",IDC_TRANSFER_RATE,207,29,51,8
    PUSHBUTTON      "Cancel",IDCANCEL,100,98,50,12,NOT WS_TABSTOP
    RTEXT           "Status  : ",IDC_DOWNLOADSTATIC,9,29,60,8
    CONTROL         "List1",IDC_PROGRESSMESSAGELIST,"SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | 
                    LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP,1,45,256,46
END

IDD_NOTINSTALLEDBOX DIALOGEX 0, 0, 235, 49
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "XLauncher error"
FONT 9, "굴림", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "확인",IDOK,93,32,50,12,WS_GROUP
    CTEXT           "Not installed this program",IDC_STATIC,7,4,221,24,
                    SS_CENTERIMAGE
END

IDD_PATCHNUMBERSERVERCONNECTDIALOG DIALOGEX 0, 0, 259, 20
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Check version"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
