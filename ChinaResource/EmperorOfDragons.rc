IDD_SELECTDEVICE DIALOG DISCARDABLE  0, 0, 199, 78
STYLE DS_CENTER | WS_POPUP | WS_BORDER
FONT 8, "MS Sans Serif"
BEGIN
    COMBOBOX        IDC_ADAPTER_COMBO,50,10,141,100,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Windowed mode",IDC_WINDOW,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP | WS_TABSTOP,49,55,85,15
    CONTROL         "&Fullscreen mode",IDC_FULLSCREEN,"Button",
                    BS_AUTORADIOBUTTON,49,41,75,15
    COMBOBOX        IDC_MODES_COMBO,50,27,141,204,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,141,42,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,141,56,50,14
    LTEXT           "Resolution:",IDC_STATIC,10,29,35,8
    EDITTEXT        IDC_EDITW,50,27,34,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDITH,87,27,34,12,ES_AUTOHSCROLL | NOT WS_VISIBLE
    LTEXT           "&Adapter",IDC_STATIC,11,12,25,8
    CONTROL         "&Windowed mode",IDC_WINDOW2,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP | WS_TABSTOP,49,55,85,15
END

IDD_COMMANDDIALOG DIALOGEX 0, 0, 319, 319
STYLE DS_MODALFRAME | DS_SETFOREGROUND | DS_CENTER | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "_XKernel command window"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "[ Command ]",IDC_STATIC,7,22,162,148
    GROUPBOX        "[ View ]",IDC_STATIC,172,22,139,148
    COMBOBOX        IDC_FILLMODECOMBO,66,38,46,87,CBS_DROPDOWNLIST | 
                    CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Fillmode",IDC_STATIC,13,39,31,11
    CONTROL         "&Fog",IDC_FOGCHECK,"Button",BS_AUTOCHECKBOX | 
                    BS_LEFTTEXT | WS_TABSTOP,12,54,61,10
    LTEXT           "Move to xz",IDC_STATIC,13,68,49,11
    LTEXT           "Move to user",IDC_STATIC,13,82,49,11
    LTEXT           "Move to mob",IDC_STATIC,13,97,49,11
    LTEXT           "Far plane",IDC_STATIC,13,125,49,11
    PUSHBUTTON      "&local user coord",IDC_VIEWLOCALUSERCOORDBUTTON,177,36,
                    61,10
    PUSHBUTTON      "&Command list",IDC_VIEWCOMMANDLISTBUTTON,177,49,61,10
    CONTROL         "Runtime info...",IDC_SCRINFOCHECK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,177,62,61,11
    CONTROL         "Axis",IDC_AXISCHECK,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,177,75,61,11
    CONTROL         "Object",IDC_OBJECTVIEWCHECK,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,177,88,61,11
    CONTROL         "Frustum",IDC_FRUSTUMVIEWCHECK,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,177,101,61,11
    CONTROL         "My setting",IDC_MYSETTINGCHECK,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,177,114,61,11
    CONTROL         "Lens flare",IDC_VIEWLENSFLARECHECK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,177,127,61,11
    CONTROL         "&OBB",IDC_OBBCHECK,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,177,141,61,11
    CONTROL         "&Light model",IDC_LIGHTMODELCHECK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,177,154,61,11
    EDITTEXT        IDC_FARPLANEEDIT,66,124,46,12,ES_AUTOHSCROLL
    CONTROL         "User culling",IDC_USERCULLINGCHECK,"Button",
                    BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP,13,110,60,11
    EDITTEXT        IDC_MOVEXZEDITX,66,67,46,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_MOVEXZEDITZ,117,67,46,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_MOVETOUSERNAME,66,81,46,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_MOVETOMOBNAME,66,95,46,12,ES_AUTOHSCROLL
    LISTBOX         IDC_COMMANDHISTORYLIST,13,275,292,40,
                    LBS_NOINTEGRALHEIGHT | NOT WS_BORDER | WS_VSCROLL | 
                    WS_TABSTOP,WS_EX_STATICEDGE
    PUSHBUTTON      "&Run",IDC_RUNCOMMANDBUTTON,278,6,33,11
    CONTROL         "&Target position",IDC_TARGETPOSITIONCHECK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,243,61,61,11
    CONTROL         "Terrain &RTime",IDC_TERRAINRENDERTIMECHECK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,243,75,61,11
    CONTROL         "&Normal vector",IDC_TERRAINNORMALCHECK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,243,87,61,11
    GROUPBOX        "[ Environment ]",IDC_STATIC,7,173,304,98
    CONTROL         "&Use texture",IDC_USETEXTURECHECK,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,243,101,61,11
    LISTBOX         IDC_ENVSETLIST,13,185,121,81,LBS_NOINTEGRALHEIGHT | NOT 
                    WS_BORDER | WS_VSCROLL | WS_TABSTOP,WS_EX_STATICEDGE
    CONTROL         "Slider1",IDC_REDSLIDER,"msctls_trackbar32",TBS_TOP | 
                    TBS_NOTICKS | WS_TABSTOP,187,186,113,10
    CONTROL         "Slider1",IDC_GREENSLIDER,"msctls_trackbar32",TBS_TOP | 
                    TBS_NOTICKS | WS_TABSTOP,187,201,113,10
    CONTROL         "Slider1",IDC_BLUESLIDER,"msctls_trackbar32",TBS_TOP | 
                    TBS_NOTICKS | WS_TABSTOP,187,216,113,10
    CONTROL         "Slider1",IDC_ALPHASLIDER,"msctls_trackbar32",TBS_TOP | 
                    TBS_NOTICKS | WS_TABSTOP,187,230,113,10
    EDITTEXT        IDC_REDEDIT,138,188,44,12,ES_RIGHT | ES_AUTOHSCROLL | 
                    ES_READONLY
    EDITTEXT        IDC_GREENEDIT,138,201,44,12,ES_RIGHT | ES_AUTOHSCROLL | 
                    ES_READONLY
    EDITTEXT        IDC_BLUEEDIT,138,214,44,12,ES_RIGHT | ES_AUTOHSCROLL | 
                    ES_READONLY
    EDITTEXT        IDC_ALPHAEDIT,138,227,44,12,ES_RIGHT | ES_AUTOHSCROLL | 
                    ES_READONLY
    EDITTEXT        IDC_VALUEEDIT,189,249,56,12,ES_AUTOHSCROLL
    LTEXT           "Value",IDC_STATIC,138,250,20,8
END

